# ---------------------------------------------------------------------------
# Variables de entorno de la plantilla.
# Copiar este archivo a `.env.local` y rellenar con los valores del proyecto
# de Supabase del negocio. `.env.local` NUNCA se versiona.
#
# Convención de claves vigente (2026):
#   - `sb_publishable_...`  -> puede llegar al navegador
#   - `sb_secret_...`       -> SOLO servidor, jamás en una variable NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# URL del proyecto: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (sb_publishable_...). Se expone al navegador de forma
# deliberada: está protegida por las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_...). Omite RLS, así que solo se usa en código de
# servidor: seed, tareas administrativas y scripts.
SUPABASE_SECRET_KEY=

# Interruptor de seguridad del seed. El seed borra blocks, site_settings y media
# antes de cargar el preset, por lo que exige este valor en `true` para correr.
# Debe quedarse en `false` (o eliminarse) en producción.
ALLOW_SEED_RESET=false
