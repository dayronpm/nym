			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "build",
			"detail": "Compilación de producción",
			"type": "shell",
			"command": "npm run build",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "verify",
			"detail": "type-check + lint + build (lo que hay que pasar antes de cada commit)",
			"type": "shell",
			"command": "npm run verify",
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "type-check",
			"detail": "Verifica TypeScript en modo estricto",
			"type": "shell",
			"command": "npm run type-check",
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "lint",
			"detail": "ESLint",
			"type": "shell",
			"command": "npm run lint",
			"problemMatcher": []
		},
		{
			"label": "format",
			detail: "Formatea el proyecto con Prettier",
			"type": "shell",
			"command": "npm run format",
			"problemMatcher": []
		}
